# Environment Variable Template for ExpenseGuard Docker & Production Configuration
# Copy this file to .env and configure your custom production values.
# DO NOT commit real production passwords or real secret keys to version control.

# PostgreSQL Container Configuration
POSTGRES_DB=expenseguard_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_PORT=5432

# Spring Boot Application Configuration
PORT=8081
SPRING_PROFILES_ACTIVE=prod

# Database Connection (In Docker Compose, database hostname is 'postgres')
DB_URL=jdbc:postgresql://postgres:5432/expenseguard_db
DB_USERNAME=postgres
DB_PASSWORD=postgres_password

# JWT Security Configuration (Replace with a strong 256-bit secret key in production)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Receipt & OCR File Storage Path inside container
RECEIPT_STORAGE_PATH=/app/uploads/receipts
